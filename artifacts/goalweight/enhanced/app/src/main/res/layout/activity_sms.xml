<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTitleSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal SMS Notifications"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textSmsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We can send you a text message when you reach your goal weight. To do this, the app needs permission to send SMS messages."
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textPhoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone number for notifications:" />

        <EditText
            android:id="@+id/editPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your mobile number"
            android:inputType="phone"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textGoalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal weight (lb):" />

        <EditText
            android:id="@+id/editGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your goal weight"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />


        <Button
            android:id="@+id/buttonRequestSmsPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable SMS Notifications"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonBackToWeights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Weights" />

        <TextView
            android:id="@+id/textSmsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current status: SMS permission not requested."
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textSmsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If you deny SMS permission, the app will still track your weight but will not send text notifications."
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
